{"type":"event","event":{"type":"message_update","content":[{"type":"thinking","thinking":"Now run the public test and additional checks of my own.","signature":""},{"type":"text","text":"Now I'll run the public test plus additional checks covering ordering, cycles, missing deps, non-mutation, and edge cases."},{"type":"tool_use","id":"[CALL_00145]","name":"shell_command","input":{"command":"python test_public.py && python - <<'EOF'\nfrom scheduler import schedule\n\n# lexicographic tie-breaking\nassert schedule({'a': [], 'b': [], 'c': []}) == ['a', 'b', 'c']\nassert schedule({'b': ['a'], 'a': []}) == ['a', 'b']\nassert schedule({'c': ['a','b'], 'b': [], 'a': []}) == ['a', 'b', 'c']\n\n# diamond: ready set tie-break\ng = {'d': ['b','c'], 'b': ['a'], 'c': ['a'], 'a': []}\nassert schedule(g) == ['a', 'b', 'c', 'd']\n\n# empty graph\nassert schedule({}) == []\n\n# single node\nassert schedule({'x': []}) == ['x']\n\n# cycle -> ValueError\nfor cyc in ({'a': ['b'], 'b': ['a']}, {'a': ['a']}, {'a': ['b'], 'b': ['c'], 'c': ['a']}):\n    try:\n        schedule(cyc)\n        raise AssertionError('expected ValueError')\n    except ValueError:\n        pass\n\n# missing dep -> KeyError\nfor bad in ({'a': ['zz']}, {'a': ['b'], 'b': ['nope']}):\n    try:\n        schedule(bad)\n        raise AssertionError('expected KeyError')\n    except KeyError as e:\n        assert e.args[0] in ('zz', 'nope')\n\n# no mutation of input (lists and dict untouched, order preserved)\ng = {'b': ['a'], 'a': []}\ndeps_before = {k: list(v) for k, v in g.items()}\nkeys_before = list(g.keys())\nschedule(g)\nassert list(g.keys()) == keys_before\nassert all(g[k] == deps_before[k] for k in g)\n\n# deps may be any iterable (tuple/set) and duplicates handled\nassert schedule({'b': ('a', 'a'), 'a': ()}) == ['a', 'b']\nassert schedule({'b': {'a'}, 'a': set()}) == ['a', 'b']\n\n# larger chain stress\nn = 2000\ng = {i: ([i-1] if i else []) for i in range(n)}\nassert schedule(g) == list(range(n))\nprint('ALL_CHECKS_OK')\nEOF","description":"Run public test and extended verification checks"}}]}}
