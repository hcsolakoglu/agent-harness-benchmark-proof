{"type":"event","event":{"type":"tool_queued","toolCallId":"[CALL_00111]","toolName":"shell_command","input":{"command":"python test_public.py && python - <<'EOF'\nimport random\nfrom cache import TTLCache\n\n# --- targeted scenarios ---\nt = [0.0]\nclk = lambda: t[0]\n\n# 1. true LRU: successful get refreshes recency\nt[0] = 0; c = TTLCache(2, 10, clk)\nc.put('a', 1); t[0] = 1; c.put('b', 2); t[0] = 2; c.get('a'); t[0] = 3; c.put('c', 3)\nassert c.get('a') == 1 and c.get('b') is None and c.get('c') == 3, \"LRU get-refresh\"\n\n# 2. get refreshes recency but NOT expiry\nt[0] = 0; c = TTLCache(2, 10, clk)\nc.put('a', 1); t[0] = 5; assert c.get('a') == 1\nt[0] = 10; assert c.get('a') is None, \"expiry not refreshed by get\"\n\n# 3. ttl boundary: expired at age >= ttl\nt[0] = 0; c = TTLCache(2, 10, clk)\nc.put('a', 1); t[0] = 9.5; assert c.get('a') == 1\nt[0] = 10; assert c.get('a') is None, \"boundary age >= ttl\"\n\n# 4. update refreshes expiry AND recency\nt[0] = 0; c = TTLCache(2, 10, clk)\nc.put('a', 1); t[0] = 5; c.put('a', 9)\nt[0] = 14; assert c.get('a') == 9, \"expiry refreshed by update\"\nt[0] = 15; assert c.get('a') is None\nt[0] = 0; c = TTLCache(2, 10, clk)\nc.put('a', 1); t[0] = 1; c.put('b', 2); t[0] = 2; c.put('a', 3); t[0] = 3; c.put('c', 4)\nassert c.get('a') == 3 and c.get('b') is None and c.get('c') == 4, \"update refreshes recency\"\n\n# 4b. update at full capacity must not evict\nt[0] = 0; c = TTLCache(1, 10, clk)\nc.put('a', 1); t[0] = 3; c.put('a', 2); assert c.get('a') == 2\nt[0] = 0; c = TTLCache(2, 10, clk)\nc.put('a', 1); t[0] = 1; c.put('b', 2); t[0] = 2; c.put('a', 3)\nassert c.get('a') == 3 and c.get('b') == 2, \"update does not evict\"\n\n# 5. expired entries must not consume capacity (fresh LRU victim survives)\nt[0] = 0; c = TTLCache(2, 10, clk)\nc.put('y', 1); t[0] = 8; c.put('x', 2); t[0] = 9; c.get('y')   # y recency 9 > x recency 8\nt[0] = 15.5; c.put('z', 3)   # y expired; must purge y, keep x, insert z\nassert c.get('x') == 2 and c.get('y') is None and c.get('z') == 3, \"expired frees capacity\"\n\n# 6. capacity <= 0 stores nothing\nfor cap in (0, -1, -5):\n    c = TTLCache(cap, 10, clk)\n    c.put('a', 1)\n    assert c.get('a') is None and len(c.data) == 0, f\"capacity {cap}\"\n\n# --- randomized differential test vs naive reference model ---\nclass Model:\n    def __init__(self, capacity, ttl):\n        self.capacity, self.ttl = capacity, ttl\n        self.entries, self.order = {}, []\n    def purge(self, now):\n        dead = [k for k, (v, ts) in self.entries.items() if now - ts >= self.ttl]\n        for k in dead:\n            del self.entries[k]; self.order.remove(k)\n    def put(self, k, v, now):\n        if self.capacity <= 0: return\n        self.purge(now)\n        if k in self.entries:\n            del self.entries[k]; self.order.remove(k)\n        else:\n            while len(self.entries) >= self.capacity:\n                ev = self.order.pop(0); del self.entries[ev]\n        self.entries[k] = (v, now); self.order.append(k)\n    def get(self, k, now):\n        if k not in self.entries: return None\n        v, ts = self.entries[k]\n        if now - ts >= self.ttl:\n            del self.entries[k]; self.order.remove(k); return None\n        self.order.remove(k); self.order.append(k)\n        return v\n\nrandom.seed(42)\nfor trial in range(400):\n    cap = random.choice([0, -1, 1, 2, 3, 5]); ttl = random.choice([0, 1, 2, 5, 10])\n    now = [0.0]; clk2 = lambda: now[0]\n    c = TTLCache(cap, ttl, clk2); m = Model(cap, ttl)\n    for op in range(400):\n        now[0] += random.choice([0, 0.5, 1, 2, 3])\n        k = random.choice(list('abcdef'))\n        if random.random() < 0.5:\n            v = random.randint(0, 100)\n            c.put(k, v); m.put(k, v, now[0])\n        else:\n            assert c.get(k, None) == m.get(k, now[0]), (trial, op, cap, ttl, now[0], k)\n        assert dict(c.data) == m.entries, (trial, op, \"contents\", cap, ttl)\n        assert list(c.data) == m.order, (trial, op, \"order\", cap, ttl)\nprint(\"ALL_CHECKS_OK\")\nEOF","cwd":"/tmp/flashbench_glm53_t03_4003930/t03","description":"Run public test, scenario suite, and differential test"}}}
