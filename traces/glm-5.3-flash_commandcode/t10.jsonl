atch, {'a': 1}, [('add', 'a', 2, 'extra')])\n\n# Missing sub key -> KeyError\nexpect(KeyError, apply_batch, {'a': 5}, [('sub', 'b', 1)])\n# Empty state sub\nexpect(KeyError, apply_batch, {}, [('sub', 'a', 1)])\n\n# sub making balance negative -> ValueError (exact and with batch context)\nexpect(ValueError, apply_batch, {'a': 5}, [('sub', 'a', 6)])\nexpect(ValueError, apply_batch, {'a': 0}, [('add', 'a', 5), ('sub', 'a', 10)])\n\n# Amount validation: strictly positive plain integers only\nfor bad in (0, -1, -100, 1.5, 2.0, \"3\", None, True, False, 3 + 0j):\n    expect(ValueError, apply_batch, {'a': 5}, [('add', 'a', bad)])\n    expect(ValueError, apply_batch, {'a': 5}, [('sub', 'a', bad)])\n\n# Non-tuple / malformed entries -> ValueError\nexpect(ValueError, apply_batch, {'a': 1}, ['add'])\nexpect(ValueError, apply_batch, {'a': 1}, [('add', 'a')])\nexpect(ValueError, apply_batch, {'a': 1}, [None])\n\n# Large ints, big batches, repeated keys\ns = {'a': 10**100}\nr = apply_batch(s, [('add', 'a', 10**100), ('sub', 'a', 5 * 10**99)])\nassert s == {'a': 10**100} and r == {'a': 5 * 10**99 + 10**100}\n\ns = {'x': 100}\nr = apply_batch(s, [('add', 'x', 1)] * 1000 + [('sub', 'x', 500)])\nassert s == {'x': 100} and r == {'x': 601}\n\n# Empty ops returns an equal but distinct copy\ns = {'a': 1}\nr = apply_batch(s, [])\nassert r == s and r is not s\n\n# Unhashable op entry raises TypeError from dict access on key... not applicable;\n# but unhashable key must not partially mutate input\ns = {'a': 1}\ntry:\n    apply_batch(s, [('add', ['k'], 2)])\nexcept TypeError:\n    pass\nassert s == {'a': 1}\n\nprint(\"ALL_CHECKS_PASSED\")\n","file_path":"/tmp/verify_ledger_t10.py"}}]}}
