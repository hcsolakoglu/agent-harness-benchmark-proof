{"type":"event","event":{"type":"tool_completed","toolCallId":"[CALL_00008]","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 65 lines\n1: import asyncio\n2: \n3: \n4: async def bounded_map(fn, items, limit):\n5:     if limit < 1:\n6:         raise ValueError(\"limit must be at least 1\")\n7: \n8:     if hasattr(items, \"__aiter__\"):\n9:         aiterator = items.__aiter__()\n10: \n11:         async def pull():\n12:             try:\n13:                 return True, await aiterator.__anext__()\n14:             except StopAsyncIteration:\n15:                 return False, None\n16:     else:\n17:         iterator = iter(items)\n18: \n19:         async def pull():\n20:             try:\n21:                 return True, next(iterator)\n22:             except StopIteration:\n23:                 return False, None\n24: \n25:     pending = {}\n26:     results = {}\n27:     submitted = 0\n28:     exhausted = False\n29: \n30:     async def fill():\n31:         nonlocal submitted, exhausted\n32:         while not exhausted and len(pending) < limit:\n33:             more, item = await pull()\n34:             if not more:\n35:                 exhausted = True\n36:                 return\n37:             task = asyncio.ensure_future(fn(item))\n38:             pending[task] = submitted\n39:             submitted += 1\n40: \n41:     await fill()\n42:     try:\n43:         while pending:\n44:             done, _ = await asyncio.wait(\n45:                 list(pending), return_when=asyncio.FIRST_COMPLETED\n46:             )\n47:             error = None\n48:             for task in done:\n49:                 index = pending.pop(task)\n50:                 exc = task.exception()\n51:                 if exc is not None:\n52:                     if error is None or index < error[0]:\n53:                         error = (index, exc)\n54:                 else:\n55:                     results[index] = task.result()\n56:             if error is not None:\n57:                 raise error[1]\n58:             await fill()\n59:     finally:\n60:         if pending:\n61:             for task in pending:\n62:                 task.cancel()\n63:             await asyncio.gather(*pending, return_exceptions=True)\n64: \n65:     return [results[index] for index in range(submitted)]"}],"deferred":false}}
