agen():\n    for i in range(5):\n        yield i\nassert asyncio.run(bounded_map(ident, agen(), 2)) == list(range(5))\n\n# --- limit validation ---\nfor bad in (0, -1, -7):\n    called = False\n    async def fn(x):\n        nonlocal called\n        called = True\n        return x\n    try:\n        asyncio.run(bounded_map(fn, [1, 2, 3], bad))\n    except ValueError:\n        assert not called, \"fn must not run for invalid limit\"\n    else:\n        raise AssertionError(f\"expected ValueError for limit={bad}\")\n# empty iterable still validated\ntry:\n    asyncio.run(bounded_map(ident, [], 0))\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError(\"expected ValueError for empty iterable\")\n\n# --- laziness: bounded in-flight window, generator not over-consumed ---\nlimit = 4\nstate = {\"pulls\": 0, \"completed\": 0, \"violations\": 0, \"active\": 0, \"max\": 0}\ndef gen():\n    i = 0\n    while i < 300:\n        state[\"pulls\"] += 1\n        yield i\n        i += 1\nasync def lazy(x):\n    pending = state[\"pulls\"] - state[\"completed\"]\n    if pending > limit or state[\"active\"] >= limit:\n        state[\"violations\"] += 1\n    state[\"active\"] += 1\n    state[\"max\"] = max(state[\"max\"], state[\"active\"])\n    await asyncio.sleep(0.001)\n    state[\"active\"] -= 1\n    state[\"completed\"] += 1\n    return x\nout = asyncio.run(bounded_map(lazy, gen(), limit))\nassert out == list(range(300)), out[:10]\nassert state[\"violations\"] == 0, state\nassert state[\"max\"] == limit, state\nassert state[\"pulls\"] == 300, state\n\n# --- laziness on infinite iterable: must not hang, error stops consumption ---\nclass Boom(Exception): pass\ninf_state = {\"pulls\": 0, \"created\": 0}\ndef inf_gen():\n    i = 0\n    while True:\n        inf_state[\"pulls\"] += 1\n        yield i\n        i += 1\nasync def fail_on_10(x):\n    inf_state[\"created\"] += 1\n    if x == 10:\n        raise Boom(\"stop\")\n    await asyncio.sleep(0.0005)\n    return x\ntry:\n    as