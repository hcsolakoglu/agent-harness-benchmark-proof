te(text):\n        while ch in seen:\n            seen.remove(text[start]); start += 1\n        seen.add(ch)\n        if i - start + 1 > best_len:\n            best_len = i - start + 1; best_start = start\n    return text[best_start:best_start + best_len]\n\nrng = random.Random(99)\ninputs = {\n    '500k / 26 letters': ''.join(rng.choice('abcdefghijklmnopqrstuvwxyz') for _ in range(500_000)),\n    '500k / 1000 unicode cps': ''.join(chr(0x4E00 + rng.randrange(1000)) for _ in range(500_000)),\n    '1M / all identical': 'x' * 1_000_000,\n    '1M / unique cps': ''.join(chr(0x4E00 + i) for i in range(1_000_000)),\n}\nfor name, s in inputs.items():\n    t = time.perf_counter()\n    got = longest_unique(s)\n    dt = time.perf_counter() - t\n    exp = set_window(s)\n    assert got == exp, (name, len(got), len(exp))\n    t2 = time.perf_counter()\n    set_window(s)\n    dt2 = time.perf_counter() - t2\n    print(f'{name:28s} len={len(s):8d} impl={dt*1000:8.1f}ms  xcheck={dt2*1000:8.1f}ms  result_len={len(got)}')\nprint('PERF_OK')\nEOF","cwd":"/tmp/flashbench_deepseek_v41/t09","description":"Benchmark large inputs and cross-validate","timeout":120000}}]}}
