{"type":"event","event":{"type":"tool_queued","toolCallId":"[CALL_00047]","toolName":"shell_command","input":{"command":"python - <<'EOF'\nimport random\nfrom window import longest_unique\n\ndef brute(text):\n    best = ''\n    for i in range(len(text)):\n        for j in range(i+1, len(text)+1):\n            s = text[i:j]\n            if len(set(s)) == len(s) and len(s) > len(best):\n                best = s\n    return best\n\n# fixed edge cases\ncases = ['', 'a', 'aa', 'ab', 'abcabcbb', 'bbbbb', 'pwwkew', 'dvdf', 'abba',\n         'tmmzuxt', 'ohvhjdml', '😀😀', '😀a😁a', 'a\\u0301a\\u0301b', ' \\t\\n\\x00 ']\nfor c in cases:\n    got, exp = longest_unique(c), brute(c)\n    assert got == exp, (repr(c), repr(got), repr(exp))\n# ties: earliest must win\nassert longest_unique('abcbca') == 'abc'\nassert longest_unique('abcade') == 'bcad'\nassert longest_unique('zabzcd') == 'abz'\n\n# randomized differential testing incl. unicode alphabet\nrng = random.Random(1234)\nalphabets = ['ab', 'abc', 'abcd', 'abcdefghij', '😀😁😂', 'aé中😀\\u0301\\x00\\n', ''.join(chr(i) for i in range(1, 300))]\nfor trial in range(4000):\n    alpha = rng.choice(alphabets)\n    n = rng.randrange(0, 40)\n    s = ''.join(rng.choice(alpha) for _ in range(n))\n    got, exp = longest_unique(s), brute(s)\n    assert got == exp, (repr(s), repr(got), repr(exp))\nprint('DIFFERENTIAL_OK')\nEOF","cwd":"/tmp/flashbench_deepseek_v41/t09","description":"Differential test new impl vs brute force"}}}
