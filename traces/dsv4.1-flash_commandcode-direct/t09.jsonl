r trial in range(4000):\n    alpha = rng.choice(alphabets)\n    n = rng.randrange(0, 40)\n    s = ''.join(rng.choice(alpha) for _ in range(n))\n    got, exp = longest_unique(s), brute(s)\n    assert got == exp, (repr(s), repr(got), repr(exp))\n\n# explicit earliest-tie check; and exhaustive small alphabets\nfor n in range(0, 13):\n    for code in range(2 ** min(n, 8)):\n        s = ''.join('ab'[(code >> k) & 1] for k in range(n))\n        got, exp = longest_unique(s), brute(s)\n        assert got == exp and (exp == '' or s.find(exp) == s.find(got)), (repr(s), repr(got), repr(exp))\nprint('DIFFERENTIAL_OK')\nEOF","cwd":"/tmp/flashbench_deepseek_v41/t09","description":"Full differential and tie-preservation test"}}]}}
