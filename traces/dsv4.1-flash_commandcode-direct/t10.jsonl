'b': 5}\n    raises(ValueError, lambda: apply_batch(s, [('add', 'a', 1), ('sub', 'b', 99)]))\n    assert s == {'a': 5, 'b': 5}, s\n\n\ndef t_unknown_op():\n    s = {'a': 5}\n    raises(ValueError, lambda: apply_batch(s, [('mul', 'a', 2)]))\n    raises(ValueError, lambda: apply_batch(s, [('ADD', 'a', 2)]))\n    raises(ValueError, lambda: apply_batch(s, [('', 'a', 2)]))\n    assert s == {'a': 5}, s\n\n\ndef t_unknown_op_after_valid():\n    s = {'a': 5}\n    raises(ValueError, lambda: apply_batch(s, [('add', 'a', 1), ('pow', 'a', 2)]))\n    assert s == {'a': 5}, s\n\n\ndef t_missing_sub_key():\n    s = {'a': 5}\n    raises(KeyError, lambda: apply_batch(s, [('sub', 'zzz', 1)]))\n    assert s == {'a': 5}, s\n\n\ndef t_missing_sub_key_after_batch_add():\n    s = {'a': 5}\n    raises(KeyError, lambda: apply_batch(s, [('add', 'b', 4), ('sub', 'c', 1)]))\n    assert s == {'a': 5}, s\n    assert apply_batch(s, [('add', 'b', 4), ('sub', 'b', 1)]) == {'a': 5, 'b': 3}\n\n\ndef t_amounts():\n    s = {'a': 5}\n    for bad in (0, -1, -5, 1.5, 2.0, '2', None, True, False, [2], (2,), 2 + 0j):\n        raises(ValueError, lambda b=bad: apply_batch(s, [('add', 'a', b)]))\n        raises(ValueError, lambda b=bad: apply_batch(s, [('sub', 'a', b)]))\n    assert s == {'a': 5}, s\n\n\ndef t_big_ints():\n    s = {'a': 10**100}\n    assert apply_batch(s, [('add', 'a', 10**100)])['a'] == 2 * 10**100\n\n\ndef t_sequential_ops_same_key():\n    s = {'a': 5}\n    assert apply_batch(s, [('sub', 'a', 3), ('add', 'a', 10), ('sub', 'a', 12)]) == {'a': 0}\n    assert s == {'a': 5}\n\n\ndef t_sequential_negative_then_fix_raises():\n    s = {'a': 1}\n    raises(ValueError, lambda: apply_batch(s, [('sub', 'a', 2), ('add', 'a', 5)]))\n    assert s == {'a': 1}\n\n\ndef t_generator_ops():\n    s = {'a': 1}\n    gen = (o for o in [('add', 'a', 2), ('sub', 'a', 1)])\n    assert apply_batch(s, gen) == {'a': 2}\n    def bad():\n        yield ('add', 'a', 1)\n        yield ('sub', 'nope', 1)\n    raises(KeyError, 